VITE_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
# Optional: Backend-Host fest erzwingen. Standardmaessig wird der aufrufende
# Host verwendet (funktioniert so auch vom Handy ueber die LAN-IP).
# Beim Cloudflare-Tunnel auf die Server-Tunnel-URL setzen.
# VITE_SERVER_URL="http://localhost:3001"
VITE_SERVER_PORT="3001"
# Optional: zusaetzlich erlaubte Dev-Hosts (kommagetrennt), z. B. eigene
# Tunnel-Domain. *.trycloudflare.com ist bereits erlaubt.
# VITE_ALLOWED_HOSTS="meine-domain.example.com"
